/**
 * variables.js - Configurazione centrale, sincronizzazione GitHub e Gestione Stato
 * Fornisce accesso globale a window.TransportVars con salvataggio affidabile e fallback
 */
window.DEFAULT_VARIABLES = {
  personale: [
 "TADDEO",
    "DI STANO",
    "RAIANO",
    "REINA",
    "LAI",
    "SINDACO",
    "GRIECO",
    "MIGLIORANZA",
    "MAGGIOLINI",
    "CONTI"
  ],
  mezzi: [
     "NAVETTA",
    "AUTO     5200",
    "AUTO     5293"
  ],
  fasce_orarie: [
    "FINE ATTIVITA",
    "08:00",
    "08:30",
    "10:00",
    "13:30",
    "14:00",
    "15:00",
    "15:30",
    "16:00",
    "16:30",
    "17:00",
    "18:30",
    "19:00",
    "20:00",
    "21:00",
    "22:00"
  ],
  github_config: {
    owner: "",
    repo: "transportmanage",
    token: "",
    branch: "main"
  }
};

window.TransportVars = {
  data: JSON.parse(JSON.stringify(window.DEFAULT_VARIABLES)),
  bookings: [],
  sha: { variables: null, bookings: null },

  // Pulisce owner o repo se l'utente incolla l'URL completo di github
  cleanGitHubParams(owner, repo) {
    let cleanOwner = (owner || '').trim();
    let cleanRepo = (repo || '').trim();

    if (cleanOwner.includes('github.com')) {
      const parts = cleanOwner.replace(/https?:\/\/github\.com\//i, '').replace(/\/$/, '').split('/');
      cleanOwner = parts[0] || '';
      if (parts[1] && !cleanRepo) cleanRepo = parts[1];
    }
    if (cleanRepo.includes('github.com')) {
      const parts = cleanRepo.replace(/https?:\/\/github\.com\//i, '').replace(/\/$/, '').split('/');
      if (parts[0]) cleanOwner = parts[0];
      cleanRepo = parts[1] || cleanRepo;
    }
    cleanRepo = cleanRepo.replace(/\.git$/i, '');
    return { owner: cleanOwner, repo: cleanRepo || 'transportmanage' };
  },

  // Inizializza leggendo da localStorage o variables.json
  async init() {
    // 1. Carica prima dalla memoria locale
    try {
      const localVars = localStorage.getItem('TM_VARIABLES_DATA');
      if (localVars) {
        const parsed = JSON.parse(localVars);
        if (parsed && Array.isArray(parsed.personale)) {
          this.data = parsed;
        }
      }
    } catch(e) { console.warn("Errore lettura localVars:", e); }

    const localOwner = localStorage.getItem('TM_GH_OWNER');
    const localRepo = localStorage.getItem('TM_GH_REPO');
    const localToken = localStorage.getItem('TM_GH_TOKEN');

    if (localOwner) this.data.github_config.owner = localOwner;
    if (localRepo) this.data.github_config.repo = localRepo;
    if (localToken) this.data.github_config.token = localToken;

    // 2. Tenta fetch di variables.json dal server/repo (con cache busting)
    try {
      const res = await fetch(`./variables.json?_nocache=${Date.now()}`, { cache: 'no-store' });
      if (res.ok) {
        const remoteData = await res.json();
        if (remoteData && Array.isArray(remoteData.personale)) {
          // Unisci mantenendo token se presente
          this.data.personale = remoteData.personale;
          this.data.mezzi = remoteData.mezzi;
          this.data.fasce_orarie = remoteData.fasce_orarie;
          if (remoteData.github_config && remoteData.github_config.token && !this.data.github_config.token) {
            this.data.github_config = remoteData.github_config;
          }
        }
      }
    } catch(e) {
      console.log("variables.json locale/fallback attivo:", e);
    }

    // 3. Se abbiamo configurazione GitHub, sincronizza bookings e variables remoti
    await this.syncGitHubData();
    return this.data;
  },

  getGitHubConfig() {
    const cfg = this.data.github_config || {};
    const owner = cfg.owner || localStorage.getItem('TM_GH_OWNER') || '';
    const repo = cfg.repo || localStorage.getItem('TM_GH_REPO') || 'transportmanage';
    const token = cfg.token || localStorage.getItem('TM_GH_TOKEN') || '';
    const branch = cfg.branch || 'main';
    return { owner, repo, token, branch };
  },

  async testConnection(customOwner, customRepo, customToken) {
    const { owner, repo } = this.cleanGitHubParams(
      customOwner || this.getGitHubConfig().owner,
      customRepo || this.getGitHubConfig().repo
    );
    const token = (customToken || this.getGitHubConfig().token || '').trim();

    if (!owner) throw new Error("Inserisci il nome utente o owner GitHub.");
    if (!token) throw new Error("Inserisci il Personal Access Token (PAT).");

    const endpoint = `https://api.github.com/repos/${owner}/${repo}`;
    const res = await fetch(endpoint, {
      headers: {
        "Authorization": `token ${token}`,
        "Accept": "application/vnd.github.v3+json"
      }
    });

    if (!res.ok) {
      if (res.status === 401) throw new Error("Token non valido o scaduto (HTTP 401).");
      if (res.status === 404) throw new Error(`Repository non trovato: https://github.com/${owner}/${repo} (HTTP 404). Verifica permessi o nome.`);
      throw new Error(`Errore GitHub HTTP ${res.status}: ${res.statusText}`);
    }

    const info = await res.json();
    return { success: true, full_name: info.full_name, private: info.private };
  },

  async saveConfig(ownerInput, repoInput, tokenInput) {
    const { owner, repo } = this.cleanGitHubParams(ownerInput, repoInput);
    const token = (tokenInput || '').trim();

    this.data.github_config.owner = owner;
    this.data.github_config.repo = repo;
    this.data.github_config.token = token;
    this.data.github_config.branch = 'main';

    localStorage.setItem('TM_GH_OWNER', owner);
    localStorage.setItem('TM_GH_REPO', repo);
    localStorage.setItem('TM_GH_TOKEN', token);
    localStorage.setItem('TM_VARIABLES_DATA', JSON.stringify(this.data));

    // Salva subito su GitHub il nuovo variables.json con la config aggiornata
    if (owner && token) {
      await this.pushVariablesToGitHub();
    }
  },

  async pushVariablesToGitHub() {
    const { owner, repo, token, branch } = this.getGitHubConfig();
    if (!owner || !token) {
      localStorage.setItem('TM_VARIABLES_DATA', JSON.stringify(this.data));
      return false;
    }

    const url = `https://api.github.com/repos/${owner}/${repo}/contents/variables.json`;
    let sha = this.sha.variables;

    try {
      const getRes = await fetch(`${url}?ref=${branch}&_nocache=${Date.now()}`, {
        headers: {
          "Authorization": `token ${token}`,
          "Accept": "application/vnd.github.v3+json"
        }
      });
      if (getRes.ok) {
        const file = await getRes.json();
        sha = file.sha;
        this.sha.variables = sha;
      }
    } catch(e) {}

    const payload = {
      message: "Update variables.json [Transport Manage App]",
      content: btoa(unescape(encodeURIComponent(JSON.stringify(this.data, null, 2)))),
      branch: branch || "main"
    };
    if (sha) payload.sha = sha;

    const putRes = await fetch(url, {
      method: "PUT",
      headers: {
        "Authorization": `token ${token}`,
        "Content-Type": "application/json",
        "Accept": "application/vnd.github.v3+json"
      },
      body: JSON.stringify(payload)
    });

    if (!putRes.ok) {
      const errJson = await putRes.json().catch(()=>({}));
      throw new Error(`Salvataggio remoto fallito (${putRes.status}): ${errJson.message || putRes.statusText}`);
    }

    const result = await putRes.json();
    if (result.content && result.content.sha) {
      this.sha.variables = result.content.sha;
    }
    localStorage.setItem('TM_VARIABLES_DATA', JSON.stringify(this.data));
    return true;
  },

  async pushBookingsToGitHub() {
    const { owner, repo, token, branch } = this.getGitHubConfig();
    localStorage.setItem('TM_BOOKINGS_DATA', JSON.stringify(this.bookings));

    if (!owner || !token) return false;

    const url = `https://api.github.com/repos/${owner}/${repo}/contents/bookings.json`;
    let sha = this.sha.bookings;

    try {
      const getRes = await fetch(`${url}?ref=${branch}&_nocache=${Date.now()}`, {
        headers: {
          "Authorization": `token ${token}`,
          "Accept": "application/vnd.github.v3+json"
        }
      });
      if (getRes.ok) {
        const file = await getRes.json();
        sha = file.sha;
        this.sha.bookings = sha;
      }
    } catch(e) {}

    const payload = {
      message: `Update bookings.json [Transport Manage App - ${new Date().toISOString()}]`,
      content: btoa(unescape(encodeURIComponent(JSON.stringify(this.bookings, null, 2)))),
      branch: branch || "main"
    };
    if (sha) payload.sha = sha;

    const putRes = await fetch(url, {
      method: "PUT",
      headers: {
        "Authorization": `token ${token}`,
        "Content-Type": "application/json",
        "Accept": "application/vnd.github.v3+json"
      },
      body: JSON.stringify(payload)
    });

    if (putRes.ok) {
      const resData = await putRes.json();
      if (resData.content && resData.content.sha) {
        this.sha.bookings = resData.content.sha;
      }
      return true;
    }
    return false;
  },

  async syncGitHubData() {
    const { owner, repo, token, branch } = this.getGitHubConfig();
    if (!owner || !token) {
      // Carica bookings da local storage se presente
      try {
        const localB = localStorage.getItem('TM_BOOKINGS_DATA');
        if (localB) this.bookings = JSON.parse(localB);
      } catch(e){}
      return false;
    }

    try {
      // 1. Sincronizza variables.json da GitHub
      const vUrl = `https://api.github.com/repos/${owner}/${repo}/contents/variables.json?ref=${branch}&_nocache=${Date.now()}`;
      const vRes = await fetch(vUrl, {
        headers: {
          "Authorization": `token ${token}`,
          "Accept": "application/vnd.github.v3+json"
        }
      });
      if (vRes.ok) {
        const vFile = await vRes.json();
        this.sha.variables = vFile.sha;
        const decoded = decodeURIComponent(escape(atob(vFile.content.replace(/\n/g, ''))));
        const parsed = JSON.parse(decoded);
        if (parsed && Array.isArray(parsed.personale)) {
          this.data = parsed;
          localStorage.setItem('TM_VARIABLES_DATA', JSON.stringify(this.data));
        }
      }

      // 2. Sincronizza bookings.json da GitHub
      const bUrl = `https://api.github.com/repos/${owner}/${repo}/contents/bookings.json?ref=${branch}&_nocache=${Date.now()}`;
      const bRes = await fetch(bUrl, {
        headers: {
          "Authorization": `token ${token}`,
          "Accept": "application/vnd.github.v3+json"
        }
      });
      if (bRes.ok) {
        const bFile = await bRes.json();
        this.sha.bookings = bFile.sha;
        const bDecoded = decodeURIComponent(escape(atob(bFile.content.replace(/\n/g, ''))));
        this.bookings = JSON.parse(bDecoded);
        localStorage.setItem('TM_BOOKINGS_DATA', JSON.stringify(this.bookings));
      } else {
        // Se non esiste ancora bookings.json remoto, usa locale
        const localB = localStorage.getItem('TM_BOOKINGS_DATA');
        if (localB) this.bookings = JSON.parse(localB);
      }
      return true;
    } catch(err) {
      console.warn("Sync GitHub fallito, fallback su memoria locale:", err);
      return false;
    }
  }
};
